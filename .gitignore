# ── Operating system ─────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Office / PDF lock and temporary files (never commit these) ───────────────
~$*
*.tmp
*.temp
*.~*

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ── R / Jupyter ──────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user

# ── LaTeX build artefacts (keep the .tex, drop the rest) ─────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/

# ── Secrets and local configuration — never commit ───────────────────────────
.env
.env.*
*.key
secrets.*
config.local.*

# ── Large files: use a GitHub Release or a shared drive instead ──────────────
#    See docs/06-submission.md §3 and data/README.md
*.zip
*.7z
*.rar
*.iso
*.mp4
*.mov
*.psd

# ── Local scratch (ignored, never shared) ────────────────────────────────────
/scratch/
*.local.*
*.bak
