# 统一换行符，避免 Windows / macOS 混用导致「整份文件都变了」
* text=auto eol=lf

# 脚本保持一致
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.sh   text eol=lf

# 二进制文件：git 不做文本差异计算（否则会误判为文本、损坏文件）
*.docx binary
*.doc  binary
*.xlsx binary
*.xls  binary
*.pptx binary
*.ppt  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.7z   binary
*.rar  binary
*.mp4  binary
